#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
tools=${LLMSPORT_T10_TOOLS:-"$root/../github-t10/.local/t10"}
if [ ! -x "$tools/venv/bin/python" ]; then
    echo "Environnement T10 local introuvable : $tools/venv/bin/python" >&2
    exit 1
fi
LLMSPORT_T10_TOOLS="$tools" exec "$tools/venv/bin/python" -IB "$root/scripts/ecran_local.py" "$@"
